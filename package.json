{
  "name": "kaeri",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -f ./docker-compose.dev.yml up -d && pnpm --filter @kaeri/shared build && pnpm -r --parallel --filter !@kaeri/shared dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "playwright test --project chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install",
    "e2e:preflight": "tsx scripts/e2e/preflight-check.ts",
    "e2e:stack": "tsx scripts/e2e/start-stack.ts",
    "e2e:cleanup": "docker compose -f ./docker-compose.e2e.yml down -v --remove-orphans",
    "check-types": "pnpm -r check-types",
    "prettier": "pnpm -r prettier",
    "dev:native": "pnpm --filter native dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint -- --fix",
    "clean:modules": "tsx scripts/clean.ts",
    "prepare": "husky",
    "commit": "cz",
    "build:deps": "pnpm --filter @kaeri/shared build",
    "update:workspaces": "pnpm -r update --interactive"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "22.15.17",
    "commitizen": "4.3.1",
    "cz-git": "1.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "mongodb": "7.0.0",
    "rimraf": "6.1.2",
    "tsx": "4.19.4",
    "mongodb-memory-server": "11.0.1"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "czConfig": "./cz.config.cjs"
    }
  },
  "packageManager": "pnpm@10.12.1"
}
